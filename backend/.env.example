MONGODB_URL=your_mongodb_connection_string_here
DATABASE_NAME=enterprise_project_management
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Calendar OAuth (optional — the "Connect Google Calendar" button
# works without these, it just tells the user it isn't configured yet).
# Get these from Google Cloud Console -> APIs & Services -> Credentials.
# The redirect URI below MUST match, character-for-character, an entry in
# your OAuth client's "Authorized redirect URIs" list.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=your_google_oauth_redirect_uri_here

# Required once GOOGLE_OAUTH_* above are set — encrypts the Google tokens
# before they're stored in MongoDB. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here
